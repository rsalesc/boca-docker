{
    "$defs": {
        "LimitModifiers": {
            "properties": {
                "timeMultiplier": {
                    "anyOf": [
                        {
                            "type": "number"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Multiplier for time limit.",
                    "title": "Timemultiplier"
                },
                "time": {
                    "anyOf": [
                        {
                            "type": "integer"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Value to override time limit with, in milliseconds.",
                    "title": "Time"
                },
                "memory": {
                    "anyOf": [
                        {
                            "type": "integer"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Value to override memory limit with, in MB.",
                    "title": "Memory"
                }
            },
            "title": "LimitModifiers",
            "type": "object"
        },
        "TimingBound": {
            "properties": {
                "value": {
                    "description": "The bound, in milliseconds. A lower bound is the smallest\ntime limit it allows, before it is rounded up to `timeResolution`; an upper bound is\nthe largest time limit it allows.",
                    "title": "Value",
                    "type": "integer"
                },
                "solution": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "The solution that set this bound, when it came from a measured\nsolution of the group. Absent when the bound was derived from another group's limit.",
                    "title": "Solution"
                }
            },
            "required": [
                "value"
            ],
            "title": "TimingBound",
            "type": "object"
        },
        "TimingGroupOrigin": {
            "enum": [
                "estimated",
                "multiplier",
                "defaulted"
            ],
            "title": "TimingGroupOrigin",
            "type": "string"
        },
        "TimingGroupReport": {
            "properties": {
                "languages": {
                    "items": {
                        "type": "string"
                    },
                    "title": "Languages",
                    "type": "array"
                },
                "timeLimit": {
                    "title": "Timelimit",
                    "type": "integer"
                },
                "origin": {
                    "$ref": "#/$defs/TimingGroupOrigin"
                },
                "solutionCount": {
                    "default": 0,
                    "title": "Solutioncount",
                    "type": "integer"
                },
                "fastest": {
                    "anyOf": [
                        {
                            "type": "integer"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "title": "Fastest"
                },
                "slowest": {
                    "anyOf": [
                        {
                            "type": "integer"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "title": "Slowest"
                },
                "relativeToLanguage": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "title": "Relativetolanguage"
                },
                "multiplier": {
                    "anyOf": [
                        {
                            "type": "number"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "title": "Multiplier"
                },
                "increment": {
                    "anyOf": [
                        {
                            "type": "integer"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "title": "Increment"
                },
                "isLeftover": {
                    "default": false,
                    "title": "Isleftover",
                    "type": "boolean"
                },
                "lowerBound": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/TimingBound"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "The lower bound this group's time limit had to respect, when it\nwas estimated from multipliers. Presentation-only."
                },
                "upperBound": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/TimingBound"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "The upper bound this group's time limit had to respect, when it\nwas estimated from multipliers and some slow solution of the group bounded it.\nPresentation-only."
                },
                "droppedUpper": {
                    "default": [],
                    "description": "Solutions of this group that were expected to be too slow but\nwere still running at `inferenceTimeout`, so they bound nothing from above.\nPresentation-only.",
                    "items": {
                        "type": "string"
                    },
                    "title": "Droppedupper",
                    "type": "array"
                }
            },
            "required": [
                "languages",
                "timeLimit",
                "origin"
            ],
            "title": "TimingGroupReport",
            "type": "object"
        },
        "TimingMultipliers": {
            "properties": {
                "acToTimeLimit": {
                    "description": "Minimum ratio between the time limit and the slowest accepted\nsolution, used to estimate the time limit from below: the slowest accepted solution\ntimes `acToTimeLimit` must fit within the time limit.",
                    "exclusiveMinimum": 0,
                    "title": "Actotimelimit",
                    "type": "number"
                },
                "timeLimitToTle": {
                    "anyOf": [
                        {
                            "exclusiveMinimum": 0,
                            "type": "number"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Minimum ratio between the fastest solution expected to be too\nslow and the time limit: the time limit times `timeLimitToTle` must fit within the\nfastest solution expected to be too slow. When omitted, solutions expected to be too\nslow are not run and the time limit is not bounded from above.",
                    "title": "Timelimittotle"
                },
                "inferenceTimeout": {
                    "default": 10000,
                    "description": "Time limit (in milliseconds) enforced on solutions while\nestimating. Only used when `timeLimitToTle` is set. A solution expected to be too\nslow that hits it is dropped from the upper bound; an accepted one that hits it is\nan error.",
                    "exclusiveMinimum": 0,
                    "title": "Inferencetimeout",
                    "type": "integer"
                },
                "timeResolution": {
                    "default": 100,
                    "description": "Granularity (in milliseconds) of the estimated time limit.\nThe estimate is the smallest multiple of this value that is valid.",
                    "exclusiveMinimum": 0,
                    "title": "Timeresolution",
                    "type": "integer"
                }
            },
            "required": [
                "acToTimeLimit"
            ],
            "title": "TimingMultipliers",
            "type": "object"
        }
    },
    "properties": {
        "inheritFromPackage": {
            "default": false,
            "description": "\nWhether to inherit limits from the package.\n",
            "title": "Inheritfrompackage",
            "type": "boolean"
        },
        "timeLimit": {
            "anyOf": [
                {
                    "type": "integer"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "Time limit of the problem, in milliseconds.",
            "title": "Timelimit"
        },
        "memoryLimit": {
            "anyOf": [
                {
                    "type": "integer"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "Memory limit of the problem, in MB.",
            "title": "Memorylimit"
        },
        "outputLimit": {
            "anyOf": [
                {
                    "type": "integer"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "Output limit of the problem, in KB.",
            "title": "Outputlimit"
        },
        "modifiers": {
            "additionalProperties": {
                "$ref": "#/$defs/LimitModifiers"
            },
            "default": {},
            "description": "\n    Limit modifiers that can be specified per language.\n    ",
            "title": "Modifiers",
            "type": "object"
        },
        "formula": {
            "anyOf": [
                {
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "\nA formula to estimate the time limit for the problem.\n",
            "title": "Formula"
        },
        "multipliers": {
            "anyOf": [
                {
                    "$ref": "#/$defs/TimingMultipliers"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "\nThe multipliers this profile was estimated from, when it was estimated from\nratios instead of a formula. Presentation-only; never used for limit resolution.\n"
        },
        "groups": {
            "anyOf": [
                {
                    "items": {
                        "$ref": "#/$defs/TimingGroupReport"
                    },
                    "type": "array"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "\nMetadata describing the language grouping used when this profile was estimated.\nPresentation-only; never used for limit resolution.\n",
            "title": "Groups"
        },
        "baseEstimate": {
            "anyOf": [
                {
                    "$ref": "#/$defs/TimingGroupReport"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "\nMetadata describing how the base (fallback) time limit was estimated, pooled\nacross every solution. Presentation-only; never used for limit resolution.\n"
        }
    },
    "title": "LimitsProfile",
    "type": "object"
}